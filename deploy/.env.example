# The server's public host name, with a DNS A record pointing at it. Gemini rejects wildcard IP names such as sslip.io.
# Changing it later disconnects every assistant: tokens are bound to https://KEPT_HOST/mcp.
KEPT_HOST=kept.example.com
# Hex passwords keep the connection URLs valid: openssl rand -hex 24
POSTGRES_PASSWORD=
KEPT_APP_PASSWORD=
