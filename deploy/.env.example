# The server's public host name, with DNS A records for it and www. pointing at the server. Gemini rejects wildcard IP names such as sslip.io.
# Changing it later disconnects every assistant: tokens are bound to https://KEPT_HOST/mcp.
KEPT_HOST=example.com
# Hex passwords keep the connection URLs valid: openssl rand -hex 24
POSTGRES_PASSWORD=
KEPT_APP_PASSWORD=
# Sends sign-in codes and invites through Resend; without it they go to the server log.
RESEND_API_KEY=
# Defaults to Kept <noreply@KEPT_HOST>; the domain must be verified in Resend.
MAIL_FROM=
