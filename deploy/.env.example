# The public host name. With a bare IP, use sslip.io: 203.0.113.7 becomes 203-0-113-7.sslip.io.
# Changing it later disconnects every assistant: tokens are bound to https://KEPT_HOST/mcp.
KEPT_HOST=203-0-113-7.sslip.io
# Hex passwords keep the connection URLs valid: openssl rand -hex 24
POSTGRES_PASSWORD=
KEPT_APP_PASSWORD=
