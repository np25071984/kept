# The server connects as kept_app, which has no BYPASSRLS (docs/IMPLEMENTATION.md §4).
DATABASE_URL=postgres://kept_app:kept_app@localhost:5433/kept
# Migrations and the create-household command run as the table owner.
DATABASE_OWNER_URL=postgres://kept:kept@localhost:5433/kept
PORT=3000
# Base URL put into emailed invite links.
PUBLIC_URL=http://localhost:3000
