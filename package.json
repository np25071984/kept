{
  "name": "kept",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p web",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "create-household": "tsx --env-file-if-exists=.env src/cli/create-household.ts",
    "create-client": "tsx --env-file-if-exists=.env src/cli/create-client.ts",
    "openapi": "tsx src/cli/openapi.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.7",
    "lucide-react": "^1.64.0",
    "oidc-provider": "^9.13.2",
    "pg": "^8.23.1",
    "typebox": "^1.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/oidc-provider": "^9.13.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
