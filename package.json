{
  "name": "kept",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "create-household": "tsx --env-file-if-exists=.env src/cli/create-household.ts",
    "openapi": "tsx src/cli/openapi.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "typebox": "^1.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
